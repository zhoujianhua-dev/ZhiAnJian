.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ==================== 临时文件 ====================
*.orig
*.bak
*.log


# ==================== 扫描引擎（scan-engine）本地文件 ====================
# .env 含 SECRET_KEY / JWT_SECRET_KEY / 数据库连接串，不入库；参考 .env.example
scan-engine/backend/.env
scan-engine/**/__pycache__/
scan-engine/**/*.py[cod]
scan-engine/frontend/node_modules/
scan-engine/frontend/dist/
scan-engine/**/*.orig
scan-engine/**/*.bak-*
scan-engine/backend/data/

# ==================== 主站前端（React） ====================
# 源码在 frontend/；node_modules 不入库。
# 构建产物 static/app/ 需要入库：Windows 双击「启动智安鉴.bat」只跑 Python，没有 Node 构建环境。
frontend/node_modules/
frontend/dist/
